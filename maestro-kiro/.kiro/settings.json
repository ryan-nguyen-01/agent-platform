{
  "$schema": "https://kiro.dev/schema/settings.json",
  "kiro": {
    "mode": "ask-do-log",
    "steering": {
      "alwaysInclude": ["steering/kiro.md", "steering/product.md", "steering/tech.md", "steering/structure.md"]
    },
    "worklog": "WORKLOG.md",
    "confirmBeforeIrreversible": true
  },
  "permissions": {
    "comment": "Kiro acts directly on in-repo work. These outward/irreversible actions require explicit user confirmation.",
    "confirm": [
      "delete data / drop tables / destructive migration",
      "deploy / publish / release",
      "git push / force-push / change remote",
      "write secrets or credentials"
    ]
  },
  "mcpServers": {}
}
